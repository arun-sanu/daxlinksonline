# =====================
# MEXC API credentials (optional when linked-runtime is enabled)
# =====================
# Leave empty if RESOLVE_EXCHANGE_FROM_BACKEND=true and BOT_INSTANCE_ID is linked.
MEXC_API_KEY=
MEXC_API_SECRET=

# =====================
# Backend integration
# =====================
BACKEND_URL=http://localhost:8000
INTERNAL_BOT_TOKEN=your_internal_bot_token

# IMPORTANT:
# Use a real BotInstance ID from your backend DB if you want direct linkage.
BOT_INSTANCE_ID=cmexamplebotinstanceid

# Optional fallbacks used by backend resolver if needed
WORKSPACE_ID=
BOT_ID=

# =====================
# Trading parameters
# =====================
SYMBOL=BTCUSDC
BASE_QUANTITY=0.001

# Pine-script strategy params
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BB_LENGTH=20
BB_MULT=2.0
STOP_LOSS_PCT=2.0
RISK_REWARD=5

# =====================
# Operations
# =====================
CHECK_INTERVAL=60
LOG_LEVEL=INFO
LOG_FILE=/var/log/mexc-bot-mexc-bot-1.log

# Resolve credentials/symbol from backend linked exchange + runtime rules
RESOLVE_EXCHANGE_FROM_BACKEND=true
BACKEND_RUNTIME_PATH=/api/v1/internal/bot/runtime-config
RUNTIME_RETRIES=3

# Retry and timeout tuning
REPORT_RETRIES=3
ORDER_RETRIES=3
REQUEST_TIMEOUT=20
HEALTH_INTERVAL=300
MEXC_RECV_WINDOW=5000

# Exchange endpoints
MEXC_WS_URL=wss://wbs.mexc.com/ws
MEXC_REST_URL=https://api.mexc.com

# Spot mode default: long-only. Set true only if your account supports shorts.
ALLOW_SHORTS=false
