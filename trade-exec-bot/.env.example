APP_ENV=development
APP_PORT=8091

# Required: TradingView/DaxLinks webhook signature secret
BOT_WEBHOOK_SECRET=replace_me

# Optional comma-separated IP allowlist for inbound webhook requests
BOT_ALLOWLIST_IPS=

# Exchange configuration
EXCHANGE_NAME=mexc
MEXC_API_KEY=replace_me
MEXC_API_SECRET=replace_me
MEXC_API_PASSWORD=
MEXC_SANDBOX=false

# Risk controls
BOT_COOLDOWN_SECONDS=30
BOT_MAX_OPEN_ORDERS_PER_SYMBOL=5
BOT_DAILY_LOSS_CAP_ENABLED=false

# DaxLinks backend internal write-back
DAXLINKS_INTERNAL_URL=http://localhost:4000/api/v1/internal/bot/order-result
DAXLINKS_INTERNAL_TOKEN=replace_me

# Optional fallback routing metadata when signal.meta is missing
DAXLINKS_WORKSPACE_ID_FALLBACK=
DAXLINKS_BOT_ID_FALLBACK=
DAXLINKS_BOT_INSTANCE_ID_FALLBACK=

HTTP_TIMEOUT_SECONDS=12
